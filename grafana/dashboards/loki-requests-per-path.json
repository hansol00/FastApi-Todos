          "calcs": [
            "sum"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "sum by (status) (\n  count_over_time(\n    {application=\"fastapi\"}\n    | pattern `<_> - \"<method> <path> <_>\" <status> <_>`\n    | path != \"\"\n    | path !~ \"/metrics|/health\"\n    [$__auto]\n  )\n)",
          "legendFormat": "{{status}}",
          "queryType": "range",
          "refId": "A"
        }
      ]
