  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "id": 1,
      "title": "Counting Requests Per Path",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "description": "/metrics(Prometheus 15초)·/health(헬스체크 30초) 자동 요청 제외. /todos/1 같은 경로는 /todos/{id} 로 묶음",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0,
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "sum by (method, path) (\n  count_over_time(\n    {application=\"fastapi\"}\n    | pattern `<_> - \"<method> <path> <_>\" <status> <_>`\n    | path != \"\"\n    | path !~ \"/metrics|/health\"\n    | label_format path=`{{ regexReplaceAll \"/[0-9]+\" .path \"/{id}\" }}`\n    [$__auto]\n  )\n)",
          "legendFormat": "{{method}} {{path}}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "id": 2,
      "title": "Responses by Status Code",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
