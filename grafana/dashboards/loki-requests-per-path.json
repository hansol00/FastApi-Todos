        "x": 12,
        "y": 0
      },
      "description": "/metrics(Prometheus 15초)·/health(헬스체크 30초) 자동 요청 제외. /todos/1 같은 경로는 /todos/{id} 로 묶음",
      "fieldConfig": {
        "defaults": {
          "custom": {
